{
  "manifest_version": 3,
  "name": "JD Disqualifier Checker",
  "version": "3.1.0",
  "description": "Scans job descriptions for disqualifying keywords: Clearance, Hybrid, Onsite, In-Person, Travel, FedRAMP.",
  "permissions": ["activeTab", "storage", "notifications"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+J",
        "windows": "Alt+J",
        "mac": "Command+Shift+J"
      },
      "description": "Open JD Disqualifier Checker"
    }
  }
}